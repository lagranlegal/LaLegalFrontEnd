# Copiar a `.env` para desarrollo local. En Vercel estas mismas tres variables
# se configuran en el proyecto de cada ambiente y se hornean en el build
# (docs/ARQUITECTURA.md §11; cómo reemplazarlas sin dejar un hueco:
# backend-starter/docs/OPERACION.md §4.3). Nunca las URLs viejas *.fly.dev:
# el CSP de la app servida bloquea esa API.
#
# VITE_API_URL y VITE_SUPABASE_URL además arman el CSP en tiempo de build
# (vite.config.ts): si falta alguna, el build FALLA a propósito en vez de
# publicar una app que no puede hablar con su backend.

VITE_API_URL=https://api-dev.prendo.com.co
VITE_SUPABASE_URL=            # proyecto Supabase dev
VITE_SUPABASE_ANON_KEY=       # publishable/anon — la ÚNICA key que puede vivir en este repo.
                              # Todo lo que empieza con VITE_ queda EMBEBIDO en el JS público:
                              # jamás poner acá la service_role key.
